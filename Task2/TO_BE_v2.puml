@startuml
!include <c4/C4_Context.puml>

LAYOUT_WITH_LEGEND()

title Диаграмма контекста ИТ-ландшафта «Здоровье+» с разделением фронтендов (Target C4 Level 1)

' АКТОРЫ
Person(patient, "Пациент клиники", "Пользователь медицинских сервисов.")
Person(staff, "Сотрудник клиники", "Врач, лаборант или администратор.")

' ФРОНТЕНД-СИСТЕМЫ (Каналы взаимодействия)
System(mobile_app, "Мобильное приложение «Здоровье+»", "Новое нативное/кроссплатформенное приложение для пациентов (iOS/Android).")
System(web_portal, "Веб-портал «Здоровье+»", "Единый веб-сайт клиники для пациентов и сотрудников.")

' ЦЕНТРАЛЬНОЕ БЭКЕНД-ЯДРО
System(health_plus_backend, "Бэкенд-платформа «Здоровье+»", "Внутренний ИТ-контур клиники. Оркестрирует бизнес-логику, управляет расписанием, хранит медкарты и кеш полисов, обрабатывает платежи и отправляет уведомления.")

' ВНЕШНИЕ СИСТЕМЫ
System_Ext(one_c_system, "1С: Полисы", "Учетная система страховых документов и проверки валидности полисов ДМС.")
System_Ext(lis_system, "LIS (Лабораторная ИС)", "Внешняя система автоматизации процессов медицинской лаборатории.")

' СВЯЗИ ПОЛЬЗОВАТЕЛЕЙ С ФРОНТЕНДАМИ
Rel(patient, mobile_app, "Записывается на прием, просматривает анализы, оплачивает услуги")
Rel(patient, web_portal, "Записывается на прием, просматривает анализы")
Rel(staff, web_portal, "Управляет сеткой расписания, просматривает медкарты пациентов")

' СВЯЗИ ФРОНТЕНДОВ С БЭКЕНДОМ
Rel(mobile_app, health_plus_backend, "Взаимодействует через API Gateway", "HTTPS")
Rel(web_portal, health_plus_backend, "Взаимодействует через API Gateway", "HTTPS")

' СВЯЗИ С ВНЕШНИМИ СИСТЕМАМИ
Rel_R(health_plus_backend, one_c_system, "Запрашивает валидность полисов при CacheMiss")
Rel_L(one_c_system, health_plus_backend, "Актуализирует данные полисов в системе")
Rel_D(lis_system, health_plus_backend, "Передает готовые результаты лабораторных исследований")

' ОБРАТНАЯ СВЯЗЬ (УВЕДОМЛЕНИЯ)
Rel_U(health_plus_backend, patient, "Отправляет уведомления о записях и готовности анализов (SMS, Email, Push)")

@enduml
